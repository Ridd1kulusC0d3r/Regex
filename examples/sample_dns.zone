; Dados sinteticos em dominios reservados para documentacao
example.org. 3600 IN A 192.0.2.10
example.org. IN 300 AAAA 2001:db8::1
www.example.org. IN CNAME example.org.
example.org. IN NS ns1.example.org.
example.org. IN MX 10 mail.example.org.
_dmarc.example.org. IN TXT "v=DMARC1; p=none; rua=mailto:reports@example.org"
example.org. IN TXT "v=spf1 ip4:192.0.2.0/24 include:_spf.example.org -all"
example.org. IN TXT "google-site-verification=token-sintetico-sensivel"
